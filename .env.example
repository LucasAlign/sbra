# Collab app environment
#
# Leave everything blank to run in SEED MODE (no external services needed):
#   npm install && npm run dev
#
# To activate the real backend (Postgres + Auth.js) — "the swap":
#   1. Set DATABASE_URL (Replit provides this when you add a Postgres DB)
#   2. npm run db:network:migrate   # apply the network migrations
#   3. npm run db:network:seed      # load the community catalog
#   4. Provision a community admin:  npm run community:provision
#   5. Set the AUTH_* vars below (Google OAuth) + AUTH_SECRET
#   6. Set NEXT_PUBLIC_BACKEND_ENABLED=1 and restart

# Postgres (runtime)
DATABASE_URL=

# Auth.js (NextAuth) — Google sign-in
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Flip the app from seed mode to the live backend
NEXT_PUBLIC_BACKEND_ENABLED=

# Integration tests only — a DISPOSABLE local Postgres, never real data.
# Must be localhost/127.0.0.1 and database name collab_test. See docs/local-postgres.md.
#   COLLAB_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/collab_test
COLLAB_TEST_DATABASE_URL=
