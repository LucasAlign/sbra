# SBRA app environment (see ticket #6 / #12)
#
# Leave everything blank to run in SEED MODE (no external services needed):
#   npm install && npm run dev
#
# To activate the real backend (Postgres + Auth.js) — "the swap":
#   1. Set DATABASE_URL (Replit provides this when you add a Postgres DB)
#   2. npm run db:push        # create tables from the Drizzle schema
#   3. Visit /api/seed once   # load the seed data into Postgres
#   4. Set the AUTH_* vars below (Google OAuth) + AUTH_SECRET
#   5. Set NEXT_PUBLIC_BACKEND_ENABLED=1 and restart

# Postgres
DATABASE_URL=

# Auth.js (NextAuth) — Google sign-in
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Flip the app from seed mode to the live backend
NEXT_PUBLIC_BACKEND_ENABLED=
