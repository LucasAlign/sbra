# Replit installs with pnpm, whose default isolated node_modules layout can
# resolve drizzle-orm twice (once hoisted, once under .pnpm with peer deps
# baked into the path). TypeScript then treats the two copies as different
# types and `next build` fails with "separate declarations of a private
# property 'shouldInlineParams'". A flat, npm-like layout collapses this to a
# single drizzle-orm instance so the build type-checks. (npm ignores this key.)
node-linker=hoisted
