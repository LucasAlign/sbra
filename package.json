{
  "name": "sbra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "community:provision": "tsx scripts/provision-community-admin.ts",
    "test:network": "tsx --test lib/network/permissions.test.ts lib/network/identity.test.ts lib/network/legacy.test.ts",
    "test:network:integration": "tsx --test lib/network/repository.integration.test.ts",
    "db:network:generate": "drizzle-kit generate --config=drizzle.network.config.ts",
    "db:network:migrate": "drizzle-kit migrate --config=drizzle.network.config.ts",
    "db:network:seed": "tsx scripts/seed-network.ts",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "directory:sync": "node scripts/sync-sbra-directory.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.24",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
